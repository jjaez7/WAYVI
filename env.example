# WAYVI 환경변수 설정
# 이 파일을 .env로 복사하고 실제 API 키를 입력하세요
# ⚠️ 절대 실제 키 값을 커밋하거나 공개 저장소/제출 파일에 포함하지 마세요.

GEMINI_API_KEY=여기에_발급받은_키_입력                # https://aistudio.google.com/ 에서 무료 발급
TOUR_API_KEY=여기에_발급받은_키_입력                  # 한국관광공사 (공공데이터포털, data.go.kr)
SEOUL_METRO_KEY=여기에_발급받은_키_입력               # 서울시 지하철 실시간 도착정보 (data.go.kr)
ODSAY_API_KEY=여기에_발급받은_키_입력                 # ODsay 대중교통 길찾기 (https://lab.odsay.com, 서비스 플랫폼: Server)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # Google Cloud STT (음성 기능 쓸 때만)
